PORT=5000
MONGODB_URI=mongodb://localhost:27017/college_db
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_STRONG_RANDOM_SECRET
NODE_ENV=development

# Email Configuration for OTP
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Default admin email (used during initial data seeding)
ADMIN_EMAIL=admin@college.edu 